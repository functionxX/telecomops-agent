# ================= TeleComOps Agent 配置模板 =================
# 复制为 .env 并按需修改。.env 已被 gitignore，不要提交任何密钥。

# ---------- 应用 ----------
APP_ENV=development
APP_NAME=TeleComOps Agent
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------- LLM（DeepSeek） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat：稳定别名，支持 JSON mode / 结构化输出（Agent 主链路用）
# deepseek-reasoner：不支持 function calling 与 JSON 输出，勿用于主链路
DEEPSEEK_MODEL=deepseek-chat
# true = 使用确定性规则 Mock（CI / 离线开发），false = 真实 API
MOCK_LLM=false
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ---------- Embedding / Reranker（BGE 系列） ----------
# 开发档位（本机 CPU 流畅）：
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# 生产档位（质量更高，模型更大）：
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu
# 维度不在此配置——代码从模型配置自动读取，禁止手写
# 国内网络建议设置 HF_ENDPOINT=https://hf-mirror.com 加速模型下载（环境变量）

# ---------- PostgreSQL（业务数据 + 关键词检索 + 状态持久化） ----------
# 本机直跑（compose 映射到 5433）：
POSTGRES_URL=postgresql+psycopg://telecomops:telecomops@localhost:5433/telecomops
# 容器内（docker compose 的 app 服务会自动覆盖为 postgres 主机名）

# ---------- Milvus（向量检索） ----------
MILVUS_URI=http://localhost:19530
# 容器不在时可用 Milvus Lite 回退（同一套 pymilvus API）：
# MILVUS_URI=./milvus_lite.db

# ---------- Milvus Collection / Index ----------
MILVUS_COLLECTION=knowledge_base
# IVF_FLAT：10 万级文档、高召回率、内存友好；nlist 约为 sqrt(数据量)
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_INDEX_NLIST=128
MILVUS_NPROBE=16
# COSINE：BGE 系列模型按余弦相似度训练/评估，方向一致
MILVUS_METRIC_TYPE=COSINE

# ---------- RAG ----------
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
# 权重不是"最佳参数"，需通过 evaluation 数据调优
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
# 检索结果最低相关性阈值（低于则明确回答"知识库未找到足够信息"）
MIN_RELEVANCE_SCORE=0.35
MAX_CONTEXT_CHARS=4000

# ---------- Workflow 循环边界 ----------
MAX_RETRIES=2
MAX_REPLANS=1
# 单次 run 工具执行总次数硬兜底，杜绝失控循环
MAX_TOOL_EXECUTIONS=10
VALIDATOR_USE_LLM=true

# ---------- Tool ----------
TOOL_TIMEOUT=5
MAX_ROWS=20
MAX_CELL_LENGTH=200

# ---------- Guardrails ----------
MAX_INPUT_LENGTH=2000

# ---------- Observability ----------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=telecomops-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
